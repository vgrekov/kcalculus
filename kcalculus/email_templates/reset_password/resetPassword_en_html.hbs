<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>
</head>

<body
    style="margin: 0; padding: 0; background-color: {{theme.colorScheme.inverseSurface}}; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
        style="background-color: {{theme.colorScheme.inverseSurface}}; padding: 40px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellspacing="0" cellpadding="0" border="0"
                    style="background: {{theme.colorScheme.surface}}; width: 100%; max-width: 600px;">
                    <tr style="background:{{theme.colorScheme.surfaceContainer}};">
                        <td align="left" valign="middle"
                            style="text-align: left; vertical-align: middle; font-size: 32px; color: {{theme.colorScheme.primary}}; padding: 24px 32px 24px 32px;">
                            kcalculus
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0"
                                style="background: {{theme.colorScheme.surface}}; border-radius: 0px; padding:40px;">
                                <tr>
                                    <td
                                        style="font-size: 16px; line-height: 1.5; color: {{theme.colorScheme.onSurface}}; padding-bottom: 32px;">
                                        We received a request to reset the password for your <strong>kcalculus</strong>
                                        account.
                                        <br><br>
                                        Click the button below to choose a new password.
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding-bottom: 32px;">
                                        <table role="presentation" cellspacing="0" cellpadding="0">
                                            <tr>
                                                <td bgcolor="{{theme.colorScheme.primaryContainer}}"
                                                    style="border-radius:32px;">
                                                    <a href="{{actionLink}}" target="_blank"
                                                        style="display: inline-block; padding: 16px 32px; font-weight: bold; line-height: 1.2; color: {{theme.colorScheme.onPrimaryContainer}}; text-decoration: none;">
                                                        Reset Password
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 14px; color: {{theme.colorScheme.onSurface}};">
                                        Alternatively, you can paste this link into your browser:
                                        <br><br>
                                    </td>
                                </tr>
                                <tr>
                                    <td
                                        style="font-family: monospace; font-size: 14px; color: {{theme.colorScheme.onSurface}}; word-break: break-all; padding-bottom: 32px;">
                                        {{actionLink}}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 14px; color: {{theme.colorScheme.onSurface}};">
                                        If you did not request a password reset, you can safely ignore this email.
                                        <br>
                                        Your password will not be changed unless you open the link above and create a
                                        new one.
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>